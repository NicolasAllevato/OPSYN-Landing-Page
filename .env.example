# Variables de entorno para api/contact.js
# Copiar este archivo como .env (o configurar en Vercel > Project Settings > Environment Variables).
# NUNCA commitear valores reales.

# --- Envío de mail (canal principal: Worker de Cloudflare, ver cloudflare/mailer/README.md) ---
# URL del Worker y token compartido (el mismo valor va como secret MAILER_TOKEN en el Worker)
MAILER_URL=https://opsyn-mailer.opsyn-la-gambeta-dely.workers.dev
MAILER_TOKEN=

# --- Respaldo opcional: Resend (solo se usa si MAILER_URL/MAILER_TOKEN no están) ---
# API Key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Email de destino que recibirá los mensajes del formulario de contacto
# y los leads que deriva el asistente virtual
CONTACT_TO_EMAIL=

# Remitente verificado en Resend (opcional; por defecto contacto@opsyn.dev)
CONTACT_FROM_EMAIL=

# ----------------------------------------------------------------------
# Asistente virtual (api/chat.js)
# ----------------------------------------------------------------------

# API Key de Google Gemini (https://aistudio.google.com/apikey). Obligatoria para el chat.
# IMPORTANTE: en producción usá una clave con facturación habilitada (plan de pago): el plan
# gratuito tiene un tope de pocos pedidos por minuto y Google puede usar los datos enviados
# para mejorar sus productos, algo que no corresponde con conversaciones de visitantes.
# El panel admin local (npm run admin) usa esta misma variable para el botón "✨ Mejorar".
GEMINI_API_KEY=

# Modelo del asistente (opcional; por defecto gemini-2.5-flash)
CHAT_MODEL=

# Webhook opcional (n8n, etc.) que recibe cada lead en JSON, además del email
LEAD_WEBHOOK_URL=

# ----------------------------------------------------------------------
# Panel de administración local (npm run admin) — SOLO uso local,
# nunca se usa en producción/Vercel. Ver docs/ADMIN.md.
# ----------------------------------------------------------------------

# El botón "✨ Mejorar" reescribe descripciones con IA usando GEMINI_API_KEY (definida arriba).
# Modelo opcional para ese botón (por defecto gemini-2.5-flash):
GEMINI_MODEL=
