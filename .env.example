# Variables de entorno para api/contact.js
# Copiar este archivo como .env (o configurar en Vercel > Project Settings > Environment Variables).
# NUNCA commitear valores reales.

# API Key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Email de destino que recibirá los mensajes del formulario de contacto
CONTACT_TO_EMAIL=

# ----------------------------------------------------------------------
# Panel de administración local (npm run admin) — SOLO uso local,
# nunca se usa en producción/Vercel. Ver docs/ADMIN.md.
# ----------------------------------------------------------------------

# API Key de Google Gemini, gratis: https://aistudio.google.com/apikey
# Usada por el botón "✨ Mejorar" para reescribir descripciones con IA.
GEMINI_API_KEY=
